<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Chat goes to the Bansify AI Worker (https://ai.bansify.com/api). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <package android:name="com.bansify.accounts" />
    </queries>

    <application
        android:name=".BansifyAiApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BansifyAI.Starting"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- OAuth callback trampoline owned by the shared Accounts SDK. -->
        <activity
            android:name="com.bansify.accounts.core.AccountCallbackActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/Theme.BansifyAI.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- Scheme-only: `com.bansify.ai:/oauth/callback` keeps `oauth` in the path. -->
                <data android:scheme="${bansifyRedirectScheme}" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ai.bansify.com"
                    android:path="/oauth/callback" />
            </intent-filter>
        </activity>

        <!-- Identity-only peer discovery between signed Bansify apps (zero tokens). -->
        <provider
            android:name="com.bansify.accounts.core.broker.AccountDirectoryProvider"
            android:authorities="${applicationId}.bansify.account.directory"
            android:exported="true" />
    </application>

</manifest>
